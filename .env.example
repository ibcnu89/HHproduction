# Gemini API Key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth (Phase 1+) ──────────────────────────────

# Neon PostgreSQL connection string
# Get yours from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:***@host/database?sslmode=require

# JWT signing secrets — generate two different 64-char strings:
# openssl rand -base64 48
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_64_char_different_random_string

# Google OAuth (Phase 3) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cookie domain — cookies bind to the exact origin (see lib/cookies.js);
# COOKIE_DOMAIN is retained only for backward compatibility and is unused.
# COOKIE_DOMAIN=.letsmakeai.fun

# ── Billing / Stripe (Phase 4) ───────────────────────
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_liv...here
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_monthly_price_id
# Canonical public origin — the APEX domain (www redirects to apex; the
# apex is what Google Console redirect URIs and FRONTEND_URL derive from).
APP_URL=https://letsmakeai.fun

# ── Email / Resend ───────────────────────────────────
# Get these from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Skyler @ HomeworkHelper <skyler@letsmakeai.fun>
# RESEND_TEST_TO=you@example.com