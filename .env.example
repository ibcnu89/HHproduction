# Gemini API Key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth (Phase 1+) ──────────────────────────────

# Neon PostgreSQL connection string
# Get yours from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT signing secrets — generate two different 64-char strings:
# openssl rand -base64 48
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_64_char_different_random_string

# Google OAuth (Phase 3) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cookie domain — .vercel.app for preview deployments, your custom domain for production
COOKIE_DOMAIN=.letsmakeai.fun

# ── Billing / Stripe (Phase 4) ───────────────────────
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID=price_your_monthly_price_id
APP_URL=https://www.letsmakeai.fun