# Cron Jobs Service for HHproduction
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies
RUN npm ci --omit=dev

# Copy scripts
COPY scripts/ ./scripts/
COPY lib/ ./lib/
COPY api/ ./api/

# Install pg_dump for db-backup-verify
RUN apk add --no-cache postgresql-client gzip

# Set environment
ENV NODE_ENV=production

# Default command - we'll override with specific cron commands
CMD ["node", "scripts/ops/mrr-snapshot.js"]