# Dockerfile for Resend Webhook Handler
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package-webhook.json ./package.json

# Install dependencies
RUN npm ci --production

# Copy application code
COPY scripts/ops/resend-webhook-server.js ./resend-webhook-server.js

# Expose port
EXPOSE 3001

# Start server
CMD ["node", "resend-webhook-server.js"]# force rebuild Wed Aug 19 12:35:13 AM CDT 2026
