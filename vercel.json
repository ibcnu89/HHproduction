{
  "rewrites": [
    { "source": "/api/auth/google/callback", "destination": "/api/auth/google/callback" },
    { "source": "/api/auth/(.*)", "destination": "/api/auth/index" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/billing/webhook.js": {
      "rawBody": true
    }
  }
}